# ============================================================
# GreenhouseBrain — example.env
# Copia a .env y ajusta los valores según tu instalación
# ============================================================

# ─────────────────────────────────────────────────────────────
# Base de datos — TimescaleDB
# ─────────────────────────────────────────────────────────────
POSTGRES_DB=greenhouse_postgres_db_name
POSTGRES_USER=greenhouse_postgres_db_user
POSTGRES_PASSWORD=greenhouse_postgres_db_password

# ─────────────────────────────────────────────────────────────
# MQTT Broker — Mosquitto
# ─────────────────────────────────────────────────────────────
MQTT_USER=greenhouse_mqtt_user
MQTT_PASSWORD=greenhouse_mqtt_pass

# ─────────────────────────────────────────────────────────────
# Grafana
# ─────────────────────────────────────────────────────────────
GRAFANA_USER=greenhouse_grafana_admin
GRAFANA_PASSWORD=greenhouse_grafana_password
GF_DS_TIMESCALE_USER=greenhouse_postgres_db_user
GF_DS_TIMESCALE_PASSWORD=greenhouse_postgres_db_password

# ─────────────────────────────────────────────────────────────
# Simulador
# ─────────────────────────────────────────────────────────────
# Intervalo de publicación de sensores en segundos
# Producción real: 120 (2 min). Para testing: 10-30
PUBLISH_INTERVAL_SEC=30

# Ciclo solar — ajustar a tu latitud y época del año
# Almería, España (verano): SUNRISE=7 SUNSET=21
# Almería, España (invierno): SUNRISE=8 SUNSET=18
SUNRISE_HOUR=7
SUNSET_HOUR=20

# Simulador de eventos extremos

EXTREME_EVENT_PROBABILITY=0.15   # 20% por tick → evento cada ~5 ticks

TIME_SCALE=60                    # 1 día simulado cada 24 min reales
SIM_START_HOUR=7
# ─────────────────────────────────────────────────────────────
# Controlador
# ─────────────────────────────────────────────────────────────
# Intervalo de evaluación de decisiones (segundos)
EVAL_INTERVAL_SEC=300

# ── Zona A — Tomate (Solanum lycopersicum) ──────────────────
# Umbrales VWC (%) — regar cuando baja de MIN, parar en MAX
ZONE_A_VWC_MIN=55
ZONE_A_VWC_MAX=80

# Umbrales temperatura (°C)
ZONE_A_TEMP_HEAT=30        # Activar ventilación
ZONE_A_TEMP_FROST=5        # Alerta de helada

# Ventana horaria de riego (horas del día, formato 0-23)
# Fuera de esta ventana, el riego solo ocurre en emergencia
ZONE_A_IRRIGATION_START=7
ZONE_A_IRRIGATION_END=19

# ── Zona B — Pimiento (Capsicum annuum) ─────────────────────
# El pimiento es muy sensible al encharcamiento (MAX ajustado)
ZONE_B_VWC_MIN=52
ZONE_B_VWC_MAX=72

ZONE_B_TEMP_HEAT=32
ZONE_B_TEMP_FROST=8        # Más sensible a bajas temperaturas

ZONE_B_IRRIGATION_START=7
ZONE_B_IRRIGATION_END=18

# ── Zona C — Pepino (Cucumis sativus) ───────────────────────
# Pepino necesita mayor y más frecuente disponibilidad hídrica
ZONE_C_VWC_MIN=65
ZONE_C_VWC_MAX=85

ZONE_C_TEMP_HEAT=33
ZONE_C_TEMP_FROST=10       # Muy sensible al frío

# Ventana ampliada: el pepino puede requerir riego temprano
ZONE_C_IRRIGATION_START=6
ZONE_C_IRRIGATION_END=20

# ─────────────────────────────────────────────────────────────
# Alerter
# ─────────────────────────────────────────────────────────────
# Cooldown entre alertas del mismo tipo (minutos)
# Evita spam de notificaciones durante condición sostenida
ALERT_COOLDOWN_MINUTES=30

# Webhook (Slack, Teams, Discord, etc.)
# Dejar vacío para deshabilitar
# Slack: https://hooks.slack.com/services/T.../B.../...
ALERT_WEBHOOK_URL=

# Email SMTP
# Dejar SMTP_HOST vacío para deshabilitar
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ─────────────────────────────────────────────────────────────
# Altitud (para cálculo ETo Penman-Monteith)
# ─────────────────────────────────────────────────────────────
# Almería: ~30m | Murcia: ~45m | Valencia: ~11m
ALTITUDE_M=50

# ─────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
