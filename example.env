# ============================================================
# GreenhouseBrain — example.env
# Copy to .env and adjust values according to your installation
# ============================================================

# ─────────────────────────────────────────────────────────────
# Database — TimescaleDB
# ─────────────────────────────────────────────────────────────
POSTGRES_DB=greenhouse_postgres_db_name
POSTGRES_USER=greenhouse_postgres_db_user
POSTGRES_PASSWORD=greenhouse_postgres_db_password

# ─────────────────────────────────────────────────────────────
# MQTT Broker — Mosquitto
# ─────────────────────────────────────────────────────────────
MQTT_USER=greenhouse_mqtt_user
MQTT_PASSWORD=greenhouse_mqtt_pass

# ─────────────────────────────────────────────────────────────
# Grafana
# ─────────────────────────────────────────────────────────────
GRAFANA_USER=greenhouse_grafana_admin
GRAFANA_PASSWORD=greenhouse_grafana_password
GF_DS_TIMESCALE_USER=greenhouse_postgres_db_user
GF_DS_TIMESCALE_PASSWORD=greenhouse_postgres_db_password

# ─────────────────────────────────────────────────────────────
# Simulator
# ─────────────────────────────────────────────────────────────
# Interval between readings, in data time seconds (5 min = 300).
# In real-time mode, this is also the actual wait time between readings.
PUBLISH_INTERVAL_SEC=300

# Solar cycle — adjust to your latitude and time of year
# Almería, Spain (summer): SUNRISE=7 SUNSET=21
# Almería, Spain (winter): SUNRISE=8 SUNSET=18
SUNRISE_HOUR=7
SUNSET_HOUR=20

# Extreme events simulator
# Probability of an event starting, per zone and per simulated HOUR (0.02 ≈ 1 event/day across the 3 zones)
EXTREME_EVENT_PROBABILITY=0.06

# Simulation clock (a single clock; data never has a future date)
# SIM_START_DAYS_AGO: the simulation starts N days ago to build history.
# TIME_SCALE: speed ONLY while "catching up" to the current time (120 = 2 hours of data per real minute).
#             Upon reaching "now", it automatically switches to real-time. When backfill is no longer needed, leave it at 1.
SIM_START_DAYS_AGO=3
TIME_SCALE=120

# ─────────────────────────────────────────────────────────────
# Controller
# ─────────────────────────────────────────────────────────────
# The controller evaluates each incoming reading (EVAL_INTERVAL_SEC is no longer used).
# IRRIGATION_INEFFECTIVE warning if a zone has been irrigating for more than N minutes and VWC remains below the minimum
IRRIGATION_MAX_MINUTES=180

# ── Zone A — Tomato (Solanum lycopersicum) ──────────────────
# VWC thresholds (%) — irrigate when below MIN, stop at MAX
ZONE_A_VWC_MIN=55
ZONE_A_VWC_MAX=80

# Temperature thresholds (°C)
ZONE_A_TEMP_HEAT=30        # Activate ventilation
ZONE_A_TEMP_FROST=5        # Frost alert

# Irrigation time window (hours of the day, 0-23 format)
# Outside this window, irrigation only occurs in emergency
ZONE_A_IRRIGATION_START=7
ZONE_A_IRRIGATION_END=19

# ── Zone B — Pepper (Capsicum annuum) ─────────────────────
# Peppers are very sensitive to waterlogging (adjusted MAX)
ZONE_B_VWC_MIN=52
ZONE_B_VWC_MAX=72

ZONE_B_TEMP_HEAT=32
ZONE_B_TEMP_FROST=8        # More sensitive to low temperatures

ZONE_B_IRRIGATION_START=7
ZONE_B_IRRIGATION_END=18

# ── Zone C — Cucumber (Cucumis sativus) ───────────────────────
# Cucumbers require higher and more frequent water availability
ZONE_C_VWC_MIN=65
ZONE_C_VWC_MAX=85

ZONE_C_TEMP_HEAT=33
ZONE_C_TEMP_FROST=10       # Very sensitive to cold

# Extended window: cucumbers may require early irrigation
ZONE_C_IRRIGATION_START=6
ZONE_C_IRRIGATION_END=20

# ─────────────────────────────────────────────────────────────
# Alerter
# ─────────────────────────────────────────────────────────────
# Cooldown between alerts of the same type (minutes)
# Prevents notification spam during sustained conditions
ALERT_COOLDOWN_MINUTES=30

# Webhook (Slack, Teams, Discord, etc.)
# Leave empty to disable
# Slack: https://hooks.slack.com/services/T.../B.../...
ALERT_WEBHOOK_URL=

# SMTP Email
# Leave SMTP_HOST empty to disable
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ─────────────────────────────────────────────────────────────
# Altitude (for Penman-Monteith ETo calculation)
# ─────────────────────────────────────────────────────────────
# Almería: ~30m | Murcia: ~45m | Valencia: ~11m
ALTITUDE_M=50

# ─────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
